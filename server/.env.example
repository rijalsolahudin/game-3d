# Salin ke .env lalu sesuaikan. Semua variabel divalidasi Zod saat boot.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Rate limit endpoint /v1/auth/* (per IP). Opsional, default 10 req / 60000 ms.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=60000
# Origin yang boleh akses lintas-origin, dipisah koma. Kosong = tidak ada.
CORS_ORIGINS=

# Proxy tepercaya (agar IP client benar di belakang Caddy/Fly/Railway).
# false (default) | daftar IP/CIDR proxy dipisah koma (mis. 10.0.0.0/8,172.16.0.1) atau keyword
# loopback/linklocal/uniquelocal. "true" dan angka hop ditolak (angka tidak berfungsi di Fastify 5.12).
TRUST_PROXY=false
