{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-3d.local/schemas/tiers.schema.json",
  "title": "Daftar tier bangunan (data/tiers.json)",
  "description": "Bangunan yang tidak terdaftar = Tier C. `id` mengacu ke id bangunan di ekspor chunk (mis. osm-way-123456). Diisi setelah survei (GAME-8). Hanya label generik: tanpa nama pemilik atau data pribadi (NFR-07).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "entries"],
  "properties": {
    "version": {"const": 1},
    "description": {"type": "string"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tier"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z]+-[a-z0-9-]+$"},
          "tier": {"enum": ["A", "B"]},
          "landmark": {"type": "string", "pattern": "^[a-z0-9_]{1,40}$"}
        }
      }
    }
  }
}
