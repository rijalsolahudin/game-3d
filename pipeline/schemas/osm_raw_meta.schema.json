{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metadata unduhan OSM mentah (GAME-6)",
  "type": "object",
  "required": ["downloaded_at", "download_date", "source", "endpoint", "query", "bbox_swne",
               "osm_base_timestamp", "element_counts", "raw_file", "raw_sha256", "license", "attribution"],
  "properties": {
    "downloaded_at": {"type": "string"},
    "download_date": {"type": "string"},
    "source": {"type": "string"},
    "endpoint": {"type": "string"},
    "query": {"type": "string"},
    "bbox_swne": {"type": "array"},
    "osm_base_timestamp": {"type": "string"},
    "element_counts": {"type": "object"},
    "raw_file": {"type": "string"},
    "raw_sha256": {"type": "string"},
    "boundary_provisional": {"type": "boolean"},
    "license": {"type": "string"},
    "attribution": {"type": "string"}
  }
}
