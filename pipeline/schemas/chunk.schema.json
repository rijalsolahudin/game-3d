{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-3d.local/schemas/chunk.schema.json",
  "title": "Chunk dunia (GAME-17): jalan, air, area, bangunan dalam koordinat lokal",
  "description": "Koordinat lokal: x = timur, z = utara, meter, origin = worlds.origin (data/origin.json). Chunk 256 m, ID \"{cx}_{cz}\". Ring polygon tanpa titik penutup; ring luar CCW, lubang CW. Bangunan tidak membawa nama/alamat (NFR-07).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chunk", "cx", "cz", "bounds", "roads", "waterways", "areas", "buildings"],
  "properties": {
    "schema_version": {"const": 1},
    "chunk": {"type": "string", "pattern": "^(0|-?[1-9][0-9]*)_(0|-?[1-9][0-9]*)$"},
    "cx": {"type": "integer"},
    "cz": {"type": "integer"},
    "bounds": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4,
               "description": "[min_x, min_z, max_x, max_z]; batas bawah inklusif, atas eksklusif"},
    "roads": {"type": "array", "items": {"$ref": "#/$defs/line"}},
    "waterways": {"type": "array", "items": {"$ref": "#/$defs/line"}},
    "areas": {"type": "array", "items": {"$ref": "#/$defs/area"}},
    "buildings": {"type": "array", "items": {"$ref": "#/$defs/building"}}
  },
  "$defs": {
    "point": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "ring": {"type": "array", "items": {"$ref": "#/$defs/point"}, "minItems": 3},
    "rings": {"type": "array", "items": {"$ref": "#/$defs/ring"}, "minItems": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9_]{1,40}$"},
    "line": {
      "type": "object",
      "additionalProperties": false,
      "description": "Potongan polyline satu ruas OSM di satu chunk. Potongan berurutan (seq n dan n+1) dengan continues_next/continues_prev true berbagi ujung identik (titik di garis batas chunk).",
      "required": ["id", "osm_id", "seq", "continues_prev", "continues_next", "kind", "width_m", "points"],
      "properties": {
        "id": {"type": "string"},
        "osm_id": {"type": "string", "pattern": "^(way|relation)/[0-9]+$"},
        "seq": {"type": "integer", "minimum": 0},
        "continues_prev": {"type": "boolean"},
        "continues_next": {"type": "boolean"},
        "kind": {"$ref": "#/$defs/slug"},
        "width_m": {"type": "number", "exclusiveMinimum": 0},
        "surface": {"type": "string", "pattern": "^[a-z0-9_:;]{1,60}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "bridge": {"const": true},
        "tunnel": {"const": true},
        "layer": {"type": "integer"},
        "points": {"type": "array", "items": {"$ref": "#/$defs/point"}, "minItems": 2}
      }
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "osm_id", "part", "category", "kind", "area_m2", "rings"],
      "properties": {
        "id": {"type": "string"},
        "osm_id": {"type": "string", "pattern": "^(way|relation)/[0-9]+$"},
        "part": {"type": "integer", "minimum": 0},
        "category": {"enum": ["landuse", "natural", "leisure", "water"]},
        "kind": {"$ref": "#/$defs/slug"},
        "area_m2": {"type": "number", "minimum": 0},
        "rings": {"$ref": "#/$defs/rings"}
      }
    },
    "building": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "kind", "tier", "height_m", "height_source", "levels", "centroid", "area_m2", "footprint"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z]+-[a-z0-9-]+$"},
        "source": {"enum": ["osm", "google", "microsoft"]},
        "osm_id": {"type": "string", "pattern": "^(way|relation)/[0-9]+$"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "kind": {"$ref": "#/$defs/slug"},
        "tier": {"enum": ["A", "B", "C"]},
        "landmark": {"$ref": "#/$defs/slug"},
        "height_m": {"type": "number", "exclusiveMinimum": 0},
        "height_source": {"enum": ["tag_height", "tag_levels", "default_kind", "default_area"]},
        "levels": {"type": ["integer", "null"], "minimum": 1},
        "centroid": {"$ref": "#/$defs/point"},
        "area_m2": {"type": "number", "exclusiveMinimum": 0},
        "footprint": {"$ref": "#/$defs/rings"}
      },
      "allOf": [
        {"if": {"properties": {"source": {"const": "osm"}}}, "then": {"required": ["osm_id"]}}
      ]
    }
  }
}
